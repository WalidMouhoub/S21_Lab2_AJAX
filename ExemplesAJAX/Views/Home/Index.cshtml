@{
    ViewData["Title"] = "Home Page";
}

@section Scripts {
    <script>
        // Chargement automatique de la première vue partielle
        $.get("/Home/Partielle", function(data) {
            $("#vuePartielle").html(data);
        });

        // Fonction appelée lorsqu'on clique sur le bouton
        function afficherPartielle2() {

            let data = {
                qty: $("#qty").val(),
                texte: $("#texte").val()
            };

            console.log(data);

            $.get("/Home/Partielle2", data, function(result) {
                $("#vuePartielle2").html(result);
            });
        }
    </script>
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>

    <!-- Première vue partielle -->
    <div id="vuePartielle"></div>

    <!-- Inputs -->
    <div>
        <input type="number" id="qty" placeholder="Quantité" />

        <input type="text" id="texte" placeholder="Entrez un texte" />

        <button type="button" onclick="afficherPartielle2()">
            Afficher
        </button>
    </div>

    <!-- Deuxième vue partielle -->
    <div id="vuePartielle2"></div>

</div>